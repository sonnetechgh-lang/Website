{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/solutions", "destination": "/pos-system", "permanent": true },
    { "source": "/client-stories", "destination": "/industries#deployments", "permanent": true },
    { "source": "/contact", "destination": "/#contact", "permanent": true }
  ],
  "headers": [
    { "source": "/LOGO/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo.html"
    }
  ]
}
